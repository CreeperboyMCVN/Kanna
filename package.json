{
  "name": "kanna",
  "productName": "Kanna",
  "version": "0.1.0",
  "description": "Kanna — a tiny desktop AI companion.",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "app.kanna.desktop",
    "productName": "Kanna",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
